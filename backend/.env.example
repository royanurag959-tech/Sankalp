# Sankalp Application Environment Configuration
# Project: Sankalp — AI-Powered Support & Recovery Companion
# Theme: Nasha Mukt Bharat — Help Today, A Better Tomorrow

PROJECT_NAME="Sankalp - AI Recovery Companion"
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for instant local setup)
DATABASE_URL="sqlite:///./sankalp.db"

# AI Provider Configuration ('demo', 'gemini', or 'openai')
AI_PROVIDER="demo"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# TinyFish API Configuration (Web Extraction & Verification of Public Helplines)
# Official documentation: https://agent.tinyfish.ai/api-keys
# Header: X-API-Key
TINYFISH_API_KEY=""
TINYFISH_FETCH_URL="https://api.fetch.tinyfish.ai"
